{
  "schema_version": "1.0.0",
  "owners": [
    { "login": "groupsum", "role": "primary" },
    { "login": "tigrbl", "role": "ecosystem" },
    { "login": "swarmauri", "role": "ecosystem" },
    { "login": "bucketwarden", "role": "product", "expect_public_repositories": false }
  ],
  "include_archived_repositories": true,
  "include_forks": true,
  "include_commit_history": true,
  "include_deployments": true,
  "max_deployments_per_repository": 30,
  "max_deployment_statuses_per_deployment": 20,
  "include_github_packages": true,
  "excluded_repository_names": [".github"],
  "manifest_names": ["package.json", "pyproject.toml", "Cargo.toml"],
  "related_resource_path_markers": ["api", "apis", "demo", "demos", "docs", "example", "examples", "showcase", "showcases", "ui", "uis", "website", "websites"],
  "max_manifests_per_repository": 500,
  "max_related_resources_per_repository": 200,
  "request_concurrency": 8,
  "request_timeout_seconds": 30,
  "cache_ttl_hours": 6,
  "downstream_discovery": {
    "github_code_search": false,
    "max_results_per_package": 100
  }
}
