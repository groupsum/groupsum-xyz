{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groupsum.xyz/catalog/site/schema.json",
  "title": "Groupsum public catalog record",
  "type": "object",
  "required": ["id"],
  "anyOf": [
    { "required": ["observed_at"] },
    { "required": ["resource_type", "label", "family", "icon_key", "detail_schema_key", "table_name", "count", "populated"] }
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": { "type": "string" },
    "route": { "type": "string", "pattern": "^/catalog/" },
    "name": { "type": ["string", "null"] },
    "display_name": { "type": ["string", "null"] },
    "description": { "type": ["string", "null"] },
    "observed_at": { "type": "string", "format": "date-time" },
    "resource_type": { "type": "string" },
    "label": { "type": "string" },
    "family": { "type": "string" },
    "icon_key": { "type": "string" },
    "detail_schema_key": { "type": "string" },
    "table_name": { "type": "string" },
    "count": { "type": "integer", "minimum": 0 },
    "populated": { "type": "boolean" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "observed_at"],
        "properties": {
          "kind": { "type": "string" },
          "url": { "type": "string" },
          "observed_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "additionalProperties": true
}
